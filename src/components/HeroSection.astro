<script>
    const track = document.getElementById("promoTrack") as HTMLElement | null;
    const dotsContainer = document.getElementById(
        "promoDots",
    ) as HTMLElement | null;
    const wrapper = document.getElementById("heroPromo") as HTMLElement | null;

    // Skip the carousel entirely while it's hidden (no timer churning off-screen).
    // Checks the inline style on purpose: offsetParent would force a full layout before first paint.
    if (track && dotsContainer && wrapper && wrapper.style.display !== "none") {
        const dots = Array.from(
            dotsContainer.querySelectorAll<HTMLButtonElement>(".promo-dot"),
        );
        const total = dots.length;
        let current = 0;
        let timer: ReturnType<typeof setInterval>;

        function goTo(index: number) {
            current = (index + total) % total;
            track!.style.transform = `translateX(-${current * 100}%)`;
            dots.forEach((d, i) => d.classList.toggle("active", i === current));
        }

        function startTimer() {
            clearInterval(timer);
            timer = setInterval(() => goTo(current + 1), 4000);
        }

        dots.forEach((dot) => {
            dot.addEventListener("click", () => {
                clearInterval(timer);
                goTo(Number(dot.dataset.index));
                startTimer();
            });
        });

        wrapper.addEventListener("mouseenter", () => clearInterval(timer));
        wrapper.addEventListener("mouseleave", startTimer);

        startTimer();
    }
</script>

<script>
    // Dithered waves background: plain WebGL2, one full-screen pass
    // (wave noise + 8x8 Bayer dither + linear->sRGB, matching the old three/postprocessing output).
    const VERT = `#version 300 es
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}`;

    const FRAG = `#version 300 es
precision highp float;
uniform vec2 resolution;
uniform float time;
uniform vec3 waveColor;
uniform vec3 backgroundColor;
out vec4 fragColor;

const float waveSpeed = 0.025;
const float waveFrequency = 4.2;
const float waveAmplitude = 0.25;
const float colorNum = 4.0;

vec4 mod289(vec4 x) { return x - floor(x * (1.0/289.0)) * 289.0; }
vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
vec2 fade(vec2 t) { return t*t*t*(t*(t*6.0-15.0)+10.0); }

float cnoise(vec2 P) {
  vec4 Pi = floor(P.xyxy) + vec4(0.0,0.0,1.0,1.0);
  vec4 Pf = fract(P.xyxy) - vec4(0.0,0.0,1.0,1.0);
  Pi = mod289(Pi);
  vec4 ix = Pi.xzxz;
  vec4 iy = Pi.yyww;
  vec4 fx = Pf.xzxz;
  vec4 fy = Pf.yyww;
  vec4 i = permute(permute(ix) + iy);
  vec4 gx = fract(i * (1.0/41.0)) * 2.0 - 1.0;
  vec4 gy = abs(gx) - 0.5;
  vec4 tx = floor(gx + 0.5);
  gx = gx - tx;
  vec2 g00 = vec2(gx.x, gy.x);
  vec2 g10 = vec2(gx.y, gy.y);
  vec2 g01 = vec2(gx.z, gy.z);
  vec2 g11 = vec2(gx.w, gy.w);
  vec4 norm = taylorInvSqrt(vec4(dot(g00,g00), dot(g01,g01), dot(g10,g10), dot(g11,g11)));
  g00 *= norm.x; g01 *= norm.y; g10 *= norm.z; g11 *= norm.w;
  float n00 = dot(g00, vec2(fx.x, fy.x));
  float n10 = dot(g10, vec2(fx.y, fy.y));
  float n01 = dot(g01, vec2(fx.z, fy.z));
  float n11 = dot(g11, vec2(fx.w, fy.w));
  vec2 fade_xy = fade(Pf.xy);
  vec2 n_x = mix(vec2(n00, n01), vec2(n10, n11), fade_xy.x);
  return 2.3 * mix(n_x.x, n_x.y, fade_xy.y);
}

float fbm(vec2 p) {
  float value = 0.0;
  float amp = 1.0;
  for (int i = 0; i < 4; i++) {
    value += amp * abs(cnoise(p));
    p *= waveFrequency;
    amp *= waveAmplitude;
  }
  return value;
}

float pattern(vec2 p) {
  vec2 p2 = p - time * waveSpeed;
  return fbm(p + fbm(p2));
}

const float bayer[64] = float[64](
  0.0, 48.0, 12.0, 60.0,  3.0, 51.0, 15.0, 63.0,
  32.0,16.0, 44.0, 28.0, 35.0, 19.0, 47.0, 31.0,
  8.0, 56.0,  4.0, 52.0, 11.0, 59.0,  7.0, 55.0,
  40.0,24.0, 36.0, 20.0, 43.0, 27.0, 39.0, 23.0,
  2.0, 50.0, 14.0, 62.0,  1.0, 49.0, 13.0, 61.0,
  34.0,18.0, 46.0, 30.0, 33.0, 17.0, 45.0, 29.0,
  10.0,58.0,  6.0, 54.0,  9.0, 57.0,  5.0, 53.0,
  42.0,26.0, 38.0, 22.0, 41.0, 25.0, 37.0, 21.0
);

vec3 toSRGB(vec3 c) {
  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0/2.4)) - 0.055, step(0.0031308, c));
}

void main() {
  vec2 uv = gl_FragCoord.xy / resolution - 0.5;
  uv.x *= resolution.x / resolution.y;
  vec3 col = mix(backgroundColor, waveColor, pattern(uv));

  ivec2 b = ivec2(mod(floor(gl_FragCoord.xy), 8.0));
  col += (bayer[b.y * 8 + b.x] / 64.0 - 0.25) / (colorNum - 1.0);
  col = clamp(col - 0.2, 0.0, 1.0);
  col = floor(col * (colorNum - 1.0) + 0.5) / (colorNum - 1.0);
  fragColor = vec4(toSRGB(col), 1.0);
}`;

    // Dark: logo-blue waves on near-black. Light: light-gray waves on logo blue.
    const LOGO_BLUE = [0, 0.2706, 0.7137];
    const THEMES = {
        dark: { wave: LOGO_BLUE, bg: [0.047, 0.0, 0.047] },
        light: { wave: [0.53, 0.53, 0.53], bg: LOGO_BLUE },
    };

    function initDither(canvas: HTMLCanvasElement) {
        const gl = canvas.getContext("webgl2", {
            antialias: false,
            depth: false,
            alpha: false,
        });
        if (!gl) return;

        const shader = (type: number, src: string) => {
            const s = gl.createShader(type)!;
            gl.shaderSource(s, src);
            gl.compileShader(s);
            return s;
        };
        const prog = gl.createProgram()!;
        gl.attachShader(prog, shader(gl.VERTEX_SHADER, VERT));
        gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, FRAG));
        gl.linkProgram(prog);

        // Let the driver compile off the main thread when it can, instead of blocking on LINK_STATUS
        const parallel = gl.getExtension("KHR_parallel_shader_compile");
        const waitForLink = () => {
            if (parallel && !gl.getProgramParameter(prog, parallel.COMPLETION_STATUS_KHR)) {
                requestAnimationFrame(waitForLink);
                return;
            }
            if (gl.getProgramParameter(prog, gl.LINK_STATUS)) run(gl, prog);
        };
        waitForLink();
    }

    function run(gl: WebGL2RenderingContext, prog: WebGLProgram) {
        const canvas = gl.canvas as HTMLCanvasElement;
        gl.useProgram(prog);

        const uRes = gl.getUniformLocation(prog, "resolution");
        const uTime = gl.getUniformLocation(prog, "time");
        const uWave = gl.getUniformLocation(prog, "waveColor");
        const uBg = gl.getUniformLocation(prog, "backgroundColor");

        const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const start = performance.now();
        let visible = false;
        let raf = 0;

        const draw = () => {
            gl.uniform1f(uTime, reduceMotion ? 0 : (performance.now() - start) / 1000);
            gl.drawArrays(gl.TRIANGLES, 0, 3);
        };
        const loop = () => {
            draw();
            raf = visible && !reduceMotion ? requestAnimationFrame(loop) : 0;
        };

        const applyTheme = () => {
            const t = document.documentElement.classList.contains("light")
                ? THEMES.light
                : THEMES.dark;
            gl.uniform3fv(uWave, t.wave);
            gl.uniform3fv(uBg, t.bg);
            draw();
        };
        new MutationObserver(applyTheme).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });

        new ResizeObserver(() => {
            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
            gl.viewport(0, 0, canvas.width, canvas.height);
            gl.uniform2f(uRes, canvas.width, canvas.height);
            draw();
        }).observe(canvas);

        // Only animate while the hero is on screen
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (visible && !raf) loop();
        }).observe(canvas);

        applyTheme();
    }

    const ditherCanvas = document.getElementById("dither") as HTMLCanvasElement | null;
    if (ditherCanvas) {
        // Decorative only: start after the page has loaded and the main thread is idle
        const start = () => initDither(ditherCanvas);
        const idle = () =>
            "requestIdleCallback" in window
                ? requestIdleCallback(start, { timeout: 2000 })
                : setTimeout(start, 200);
        if (document.readyState === "complete") idle();
        else addEventListener("load", idle, { once: true });
    }
</script>
