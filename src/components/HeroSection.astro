---
import HeroDither from "./HeroDither.jsx";
---

<section class="hero-section">
    <!-- Dither: WebGL blob in the lower-left, masked. Deferred (client:idle) so
         it loads after the page is interactive — keeps the initial render fast. -->
    <div class="dither-blob" aria-hidden="true">
        <HeroDither
            client:idle
            waveSpeed={0.025}
            waveFrequency={4.2}
            waveAmplitude={0.25}
            waveColor={[0, 0.2706, 0.7137]}
            colorNum={4}
            pixelSize={1}
        />
    </div>

    <!-- Content: two-column grid (text | mundial showcase) -->
    <div class="hero-content">
        <!-- Left column: text -->
        <div class="hero-text">
            <!-- Badge pill — World Cup teaser -->
            <a href="#mundial" class="hero-badge hero-badge--mundial">
                <span class="badge-dot"></span>
                <span>Copa del Mundo 2026 · todos los partidos en CCC Go</span>
                <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                >
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>

            <!-- Headline -->
            <h1 class="hero-title">
                Conectate al<br />
                <em>futuro.</em>
            </h1>

            <!-- Sub-text -->
            <p class="hero-sub">
                CCC te lleva internet rápido y TV por cable en alta definición a
                tu puerta, todo en un solo plan simple.
            </p>

            <!-- CTA buttons -->
            <div class="hero-ctas">
                <a href="#plans" class="btn-primary">
                    Ver planes
                    <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                    >
                        <path d="M5 12h14M12 5l7 7-7 7"></path>
                    </svg>
                </a>
                <a href="#contact" class="btn-secondary">Contacto</a>
            </div>

            <!-- Trust line -->
            <p class="hero-trust">
                Elegido por más de <span>15.000</span> hogares en toda la provincia.
            </p>
        </div>

        <!-- Right column: Mundial 2026 showcase -->
        <a
            href="#mundial"
            class="hero-mundial-card"
            aria-label="Mirá el Mundial 2026 en CCC Go"
        >
            <img
                src="/wc2026-pattern.webp"
                alt=""
                class="hmc-bg"
                aria-hidden="true"
                decoding="async"
            />
            <span class="hmc-live">
                <span class="hmc-dot"></span>
                EN VIVO
            </span>
            <div class="hmc-overlay">
                <img
                    src="/wc2026-logo.png"
                    alt=""
                    class="hmc-logo"
                    aria-hidden="true"
                    decoding="async"
                />
                <div class="hmc-text">
                    <strong>Mundial 2026</strong>
                    <span>
                        Todos los partidos en CCC Go
                        <svg
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                        >
                            <path d="M5 12h14M12 5l7 7-7 7"></path>
                        </svg>
                    </span>
                </div>
            </div>
        </a>
    </div>
</section>

<style>
    /* ── Section ── */
    .hero-section {
        position: relative;
        min-height: 100vh;
        background: var(--color-bg);
        overflow: hidden;
        display: flex;
        align-items: center;
    }

    /* ── Dither blob ── */
    .dither-blob {
        position: absolute;
        left: 0;
        bottom: 0;
        transform: translate(-50%, 50%);
        width: clamp(560px, 70vw, 900px);
        height: clamp(560px, 70vw, 900px);
        overflow: hidden;
        -webkit-mask-image: radial-gradient(
            circle closest-side at 50% 50%,
            black 0%,
            rgba(0, 0, 0, 0.8) 35%,
            rgba(0, 0, 0, 0.3) 65%,
            transparent 90%
        );
        mask-image: radial-gradient(
            circle closest-side at 50% 50%,
            black 0%,
            rgba(0, 0, 0, 0.8) 35%,
            rgba(0, 0, 0, 0.3) 65%,
            transparent 90%
        );
    }
    .dither-blob astro-island {
        display: block;
        width: 100%;
        height: 100%;
    }

    /* ── Content grid ── */
    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 8rem 2rem 6rem;
        display: grid;
        grid-template-columns: 55fr 45fr;
        align-items: center;
        gap: 3rem;
    }

    /* ── Left column ── */
    .hero-text {
        display: flex;
        flex-direction: column;
    }

    /* ── Badge ── */
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.9rem;
        background: var(--color-pill-bg);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        margin-bottom: 1.75rem;
        font-size: 0.8125rem;
        color: var(--color-muted);
        font-weight: 500;
        letter-spacing: 0.01em;
        align-self: flex-start;
    }
    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-accent);
        flex-shrink: 0;
        box-shadow: 0 0 6px var(--color-accent);
    }

    /* ── Badge as Mundial teaser link ── */
    .hero-badge--mundial {
        cursor: pointer;
        text-decoration: none;
        transition:
            border-color 0.2s,
            color 0.2s,
            background 0.2s,
            transform 0.15s;
    }
    .hero-badge--mundial .badge-dot {
        background: #e2001a;
        box-shadow: 0 0 8px #e2001a;
        animation: badgePulse 1.5s ease-in-out infinite;
    }
    .hero-badge--mundial:hover {
        color: var(--color-foreground);
        border-color: var(--color-border-light);
        background: var(--color-pill-hover);
        transform: translateY(-1px);
    }
    .hero-badge--mundial svg {
        opacity: 0.55;
        flex-shrink: 0;
    }
    @keyframes badgePulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.4;
            transform: scale(0.7);
        }
    }

    /* ── Headline ── */
    .hero-title {
        font-size: clamp(2.5rem, 5.5vw, 4.5rem);
        font-weight: 800;
        line-height: 1.06;
        letter-spacing: -0.035em;
        color: var(--color-foreground);
        margin: 0 0 1.25rem;
    }
    .hero-title em {
        font-style: italic;
        color: var(--color-accent);
    }

    /* ── Sub ── */
    .hero-sub {
        font-size: clamp(1rem, 1.8vw, 1.125rem);
        color: var(--color-muted);
        line-height: 1.65;
        max-width: 480px;
        margin: 0 0 2.25rem;
    }

    /* ── CTAs ── */
    .hero-ctas {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }
    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1.4rem;
        background: var(--color-accent);
        color: #fff;
        border-radius: 9999px;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--color-accent);
        transition:
            background 0.2s,
            transform 0.15s;
        box-shadow: 0 0 20px var(--color-accent-subtle);
    }
    .btn-primary:hover {
        background: var(--color-accent-light);
        transform: translateY(-1px);
    }
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        padding: 0.7rem 1.4rem;
        background: transparent;
        color: var(--color-foreground);
        border-radius: 9999px;
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid var(--color-border);
        transition:
            border-color 0.2s,
            color 0.2s,
            transform 0.15s;
    }
    .btn-secondary:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        transform: translateY(-1px);
    }

    /* ── Trust line ── */
    .hero-trust {
        font-size: 0.8125rem;
        color: var(--color-foreground-alt);
        margin: 0;
    }
    .hero-trust span {
        color: var(--color-muted);
    }

    /* ── Right column: Mundial 2026 showcase ── */
    .hero-mundial-card {
        position: relative;
        display: block;
        aspect-ratio: 16 / 10;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--color-border-light);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
        text-decoration: none;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }
    .hero-mundial-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 28px 70px rgba(0, 0, 0, 0.55);
    }
    .hmc-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .hero-mundial-card:hover .hmc-bg {
        transform: scale(1.05);
    }
    .hmc-live {
        position: absolute;
        top: 0.9rem;
        right: 0.9rem;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.28rem 0.7rem;
        border-radius: 9999px;
        background: #e2001a;
        color: #fff;
        font-size: 0.625rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        box-shadow: 0 4px 16px rgba(226, 0, 26, 0.5);
    }
    .hmc-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #fff;
        animation: badgePulse 1.4s ease-in-out infinite;
    }
    .hmc-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        align-items: flex-end;
        gap: 0.85rem;
        padding: 1.1rem;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.85) 0%,
            rgba(0, 0, 0, 0.2) 45%,
            transparent 70%
        );
    }
    .hmc-logo {
        width: 52px;
        height: 52px;
        object-fit: contain;
        flex-shrink: 0;
        filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.6));
    }
    .hmc-text {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }
    .hmc-text strong {
        font-size: 1.0625rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.01em;
    }
    .hmc-text span {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.8);
    }

    /* ── Mobile ── */
    @media (max-width: 768px) {
        .hero-content {
            grid-template-columns: 1fr;
            padding: 6rem 1.5rem 4rem;
            gap: 2.5rem;
        }
        .hero-title {
            max-width: 100%;
        }
        .hero-sub {
            max-width: 100%;
        }
        .dither-blob {
            left: 0;
            bottom: 0;
            transform: translate(-50%, 50%);
            width: 90vw;
            height: 90vw;
            opacity: 0.55;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-mundial-card,
        .hmc-bg,
        .hero-badge--mundial {
            transition: none;
        }
        .hmc-dot,
        .hero-badge--mundial .badge-dot {
            animation: none;
        }
    }
</style>
